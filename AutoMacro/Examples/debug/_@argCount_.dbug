Set @argCount.clone=For %. in (1 2)Do if %.==2 (%\n%
For /f "tokens=1,* Delims= " %%? in ("@!@argCount.Args:-=!")Do Set "@argCount.args=%%@"%\n%
Set /a "$argCount=0","$argCountError=0"%\n%
For /f "delims=-\@$.[]{}:;_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ " %%G in ("!@argCount.args!")Do Set "$argCountError=1"%\n%
