@argCount=For %. in (1 2)Do if %.==2 (For /f "tokens=1,* Delims= " %? in ("@!@argCount.Args:-=!")Do Set "@argCount.args=%@"
Set /a "$argCount=0","$argCountError=0"
For /f "delims=-\@$.[]{}:;_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ " %G in ("!@argCount.args!")Do Set "$argCountError=1"
If !$argCountError! EQU 0  (If "!@argCount.args:~-1!"==" " Set "@argCount.args=!@argCount.args:~0,-1!"
Set /A "$argCount=(((!@argCount.args: =>>31)+3>>1)+((!>>31)+3>>1))")) Else Set @argCount.Args=
