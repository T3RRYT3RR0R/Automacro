Set /a "@getKey.while=@getKey.while.start","@getKey.while.do=1" & For /l %^~ in (1 1 16)Do if defined @getKey.while.do For /l %^~ in (1 1 16)Do if defined @getKey.while.do For /l %^~ in (1 1 16)Do if defined @getKey.while.do For /l %^~ in (1 1 16)Do if defined @getKey.while.do Set /a "@getKey.while+=1" &  if not defined %~1 ("C:\Users\tcdou\AppData\Local\Temp\BG.exe" !@.mode!
Set "%~1=!errorlevel!"
