@lookup=For %. in (1 2)Do if %.==2 (For /f "tokens=1,2,3,4" %K in ("!@lookup.args: /o=! !@lookup.Keypair.Delim!")Do (If not "!%L:%N%~K%N=!" == "!%L!" (For /f "tokens=1 Delims=:" %1 in ("!%L:*%N%~K%N=!")Do Set "%M=%1"
If not "!@lookup.args: /o=!" == "!@lookup.args!" echo(^!%M^!))) Else Set @lookup.Args=
@lookup.end=47
@lookup.Keypair.Delim=:
@lookup.path=C:\Users\tcdou\Desktop\AutoMacro\Macros\datastructures\@lookup.mac
