@wait=For %. in (1 2)Do if %.==2 (Set /a "$wait=$wait.start","$wait.do=1" & For /l %^~ in (1 1 16)Do if defined $wait.do For /l %^~ in (1 1 16)Do if defined $wait.do For /l %^~ in (1 1 16)Do if defined $wait.do For /l %^~ in (1 1 16)Do if defined $wait.do For /l %^~ in (1 1 16)Do if defined $wait.do Set /a "$wait+=1" &  (For /f "tokens=1,* Delims= " %i in ("$waitamount !@wait.args:* =!")Do If not "!%i.CS!"=="!time:~-1!" (Set /A "@wait.tDiff=!time:~-1!-%i.CS","%i.CS=!time:~-1!"
If "!@wait.tDiff:~0,-1!"=="-" (Set /A "@wait.tDiff+=10,%i.elapsed=%i.elapsed % 100000000+@wait.tDiff,%i=%i % 100000000+@wait.tDiff","@wait.Target=%~j")Else Set /A "%i.elapsed=%i.elapsed % 100000000+@wait.tDiff,%i=%i % 100000000+@wait.tDiff","@wait.Target=%~j"
if !%i! GEQ !@wait.TARGET! (Set /a "@wait.tDiff=0,@wait.current=0,%i=0"
Set "$wait.do=" )))) Else Set @wait.Args=
@wait.end=27
